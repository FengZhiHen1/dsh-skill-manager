{
  "name": "dsh-skill-manager",
  "version": "0.2.0",
  "private": true,
  "description": "DSH 设置页技能管理插件：配置本地 skills 目录（纯 skill 平铺目录）后，管理库、分组与 DSH 挂载（junction-only），支持 skills.sh 搜索、GitHub 入库、检查更新、备份恢复与禁用启用；配置即意图存 settings，运行时投影存 DSH storage 域，失败附一键复制修复提示词。",
  "type": "module",
  "main": "./src/adapter/index.js",
  "exports": {
    ".": "./src/adapter/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "files": [
    "src/",
    "dist/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build-client.mjs",
    "test": "node --test test/*.test.mjs",
    "layering": "node ../../tools/plugin-layering-check.mjs .",
    "check": "node build-client.mjs --check && node check-syntax.mjs && npm run layering && node --test test/*.test.mjs"
  },
  "dependencies": {
    "schemastery": "^3.18.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-storage-domain": "0.1.2-rc.1",
    "esbuild": "^0.28.2"
  }
}
